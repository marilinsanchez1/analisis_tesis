```{r}
#| label: setup

source('https://inkaverse.com/setup.r')

library(googlesheets4)
library(dplyr)

```

```{r}
gs <- "https://docs.google.com/spreadsheets/d/1rXyxAFP6_3B07Bao6n6iNVQTelzpieGEApLEG4y5N1Y/edit?gid=15317186#gid=15317186"

fb <- read_sheet(gs, sheet = "fb") %>%
  mutate(
    Clon = factor(case_when(
      Trat %in% c("T1","T2","T3","T4") ~ "Tropical",
      Trat %in% c("T5","T6","T7","T8") ~ "Magenta"
    ), levels = c("Tropical","Magenta")),
    Sustrato = factor(case_when(
      Trat %in% c("T1","T5") ~ "Cascarilla",
      Trat %in% c("T2","T6") ~ "Bocashi",
      Trat %in% c("T3","T7") ~ "Fibra_coco",
      Trat %in% c("T4","T8") ~ "Fibra_palma"
    ), levels = c("Cascarilla","Bocashi","Fibra_coco","Fibra_palma")),
    Rep = factor(repeticion)
  )

str(fb)
```

```{r}
fb <- fb %>%
  group_by(Trat, Clon, Sustrato, Rep) %>%
  summarise(
    altura_30    = mean(altura_30,    na.rm = TRUE),
    diametro_60  = mean(diametro_60,  na.rm = TRUE),
    longitud_150 = mean(longitud_150, na.rm = TRUE),
    .groups = "drop"
  )
```

#graficar

```{r}
ggplot(fb, aes(x = Clon, y = altura_30, fill = Sustrato)) +
  geom_boxplot(position = position_dodge(width = 0.8), alpha = 0.8) +
  labs(
    title = "Altura a los 30 días por clon y sustrato",
    x = "Clon",
    y = "Altura a los 30 días (cm)",
    fill = "Sustrato"
  ) +
  theme_minimal() +
  theme(
    axis.text.x = element_text(angle = 45, hjust = 1),
    legend.position = "top"
  )
```

