library(googlesheets4)
library(dplyr)
mod_altura <- aov(altura_30 ~ Clon * Sustrato, data = fb)
summary(mod_altura)
anova (mod_altura)
plot (mod_altura)
library(agricolae)
# --- Sobre la interacción (recomendado si A×B significativa) ---
fb <- fb %>%
mutate(Interaccion = interaction(Clon, Sustrato))
mod_int <- aov(altura_30 ~ Interaccion, data = fb)
LSD.test(mod_int, "Interaccion", group = TRUE, console = TRUE)
# --- Sobre sustrato (si A×B NO significativa) ---
LSD.test(mod_altura, "Sustrato", group = TRUE, console = TRUE)
# --- Sobre clon (si A×B NO significativa) ---
LSD.test(mod_altura, "Clon", group = TRUE, console = TRUE)
library(ggplot2)
ggplot(fb, aes(x = Sustrato, y = altura_30,
color = Clon, group = Clon)) +
stat_summary(fun = mean, geom = "point", size = 3) +
stat_summary(fun = mean, geom = "line", size = 1) +
stat_summary(fun.data = mean_se, geom = "errorbar", width = 0.2) +
labs(
title = "Interacción Clon × Sustrato — Altura 30 días",
x = "Sustrato",
y = "Altura 30 días (cm)",
color = "Clon"
) +
theme_minimal() +
theme(legend.position = "top")
mc_i <- mod_altura %>%
emmeans(~ Clon | Sustrato) %>%
cld(Letters = letters, reversed = TRUE) %>%
mutate(across(".group", trimws)) %>%
mutate(across(".group", tolower)) %>%
rename(sig_i = ".group")
mc_o <- mod_altura %>%
emmeans(~ Clon | Sustrato) %>%
cld(Letters = letters, reversed = TRUE) %>%
mutate(across(".group", trimws)) %>%
mutate(across(".group", toupper)) %>%
rename(sig_o = ".group")
mc <- merge(mc_i, mc_o) %>%
unite(col = "sig", c("sig_i", "sig_o"), sep = "")
View(mc)
mc_i <- mod_altura %>%
emmeans(~ Clon | Sustrato) %>%
cld(Letters = letters, reversed = TRUE) %>%
mutate(across(".group", trimws)) %>%
mutate(across(".group", tolower)) %>%
rename(sig_i = ".group")
mc_o <- mod_altura %>%
emmeans(~ Clon | Sustrato) %>%
cld(Letters = letters, reversed = TRUE) %>%
mutate(across(".group", trimws)) %>%
mutate(across(".group", toupper)) %>%
rename(sig_o = ".group")
mc <- merge(mc_i, mc_o) %>%
unite(col = "sig", c("sig_i", "sig_o"), sep = "")
{r}
mc %>%
plot_smr(type = "line"
,x = "Sustrato"
, y = "emmean"
, group = "Clon"
, sig = "sig"
, sigsize = 2
, error = "SE"
)
# 1. Crear el gráfico y guardarlo en un objeto 'p'
p <- ggplot(mtcars, aes(wt, mpg)) + geom_point()
# 2. Exportar especificando tamaño y resolución
ggsave("mi_grafico.png", plot = p, width = 8, height = 6, dpi = 300)
